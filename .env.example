# Quelle base l'application interroge. Seule la valeur « ops » supprime le
# bandeau d'avertissement affiche en tete de l'application ; toute autre
# valeur, ou l'absence de la variable, est traitee comme une base de test.
# VITE_BASE_LIBELLE nomme la base dans ce bandeau (facultatif).
VITE_BASE=test
VITE_BASE_LIBELLE=nom-de-la-base — region

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_APP_URL=https://your-domain.example

# Scripts d'import uniquement (scripts/import-demo.ts) — jamais lue par le front.
# Contourne tout le RLS : ne la mettre que dans .env, jamais dans un fichier versionné.
SUPABASE_SERVICE_ROLE_KEY=
