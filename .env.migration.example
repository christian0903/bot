# ============================================================================
# Modele de configuration pour les scripts de migration.
#
#   cp .env.migration.example .env.migration
#   puis remplir, et NE JAMAIS le commiter (.gitignore couvre deja .env.*)
#
# Les deux scripts lisent ce fichier :
#   scripts/creer-espace-application.sh  — cree un espace applicatif complet
#   scripts/migrer-donnees.sh            — copie les donnees d'une base a une autre
#
# Tout est facultatif : ce qui manque est demande a la saisie. Remplir ce
# fichier evite simplement de ressaisir a chaque essai.
# ============================================================================

# ── La base a creer ou a remplir (la CIBLE) ─────────────────────────────────
# La reference du projet Supabase, visible dans son URL :
#   https://<ref>.supabase.co
CIBLE_REF=
CIBLE_PASSWORD=
# Service role key (Project Settings > API). Sert a copier le Storage.
CIBLE_SERVICE_KEY=

# ── La base d'origine (la SOURCE) — script de migration uniquement ──────────
SOURCE_REF=
SOURCE_PASSWORD=
SOURCE_SERVICE_KEY=
# `bot` ne repond plus en connexion directe : il faut passer par le pooler,
# dont le prefixe (aws-0 / aws-1) ne se devine pas. Le laisser vide fait
# tenter la connexion directe, ce qui convient aux bases recentes.
#   Project Settings > Database > Connection string > onglet Session pooler
SOURCE_POOLER=

# ── Secrets des Edge Functions ──────────────────────────────────────────────
# Poses sur la base cible par creer-espace-application.sh.
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY ne figurent pas
# ici : Supabase les fournit lui-meme a chaque fonction.

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# L'application choisit entre test et live selon app_settings.stripe_mode, en
# base — pas selon un secret. Les quatre peuvent donc coexister, et une base
# neuve demarre en mode test (pose par install.sql).
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=

# URL publique de l'application, utilisee par les fonctions pour construire
# les liens des e-mails.
APP_URL=

# ── Premier compte administrateur ───────────────────────────────────────────
# L'adresse a promouvoir super_admin. Le compte doit exister : s'inscrire par
# l'application AVANT de lancer l'etape de promotion.
SUPER_ADMIN_EMAIL=
